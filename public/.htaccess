<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Route API requests to PHP proxy
  RewriteRule ^api/(.*)$ proxy.php [L,QSA]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !^/api/
  RewriteRule . /index.html [L]
</IfModule>
